{
  "schemaVersion": 1,
  "features": {
    "core": {
      "label": "Core Agent",
      "required": true,
      "description": "Porrima app, managed llama.cpp services, local storage, memory, and chat.",
      "dependencies": [
        "linux",
        "systemd-user",
        "node",
        "npm",
        "native-build-tools",
        "llama.cpp",
        "desktop-gpu"
      ],
      "services": [
        "porrima.service",
        "llama-server.service",
        "extraction-model.service",
        "reranker.service",
        "embedding-model.service",
        "title-generation.service"
      ]
    },
    "tts": {
      "label": "Voice Pack",
      "required": false,
      "description": "Python TTS backends and audio tooling. Can be added after core setup.",
      "dependencies": [
        "python3.10-3.13",
        "python3-venv",
        "pip",
        "ffmpeg"
      ],
      "services": []
    },
    "automations": {
      "label": "Automation Pack",
      "required": false,
      "description": "Scheduled routines, notifications, and background autonomy defaults.",
      "dependencies": [
        "core"
      ],
      "services": []
    }
  },
  "recommendedDefault": [
    "core"
  ]
}
